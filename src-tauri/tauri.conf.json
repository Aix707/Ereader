{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ereader",
  "version": "2.0.0",
  "identifier": "com.aix707.ereader",
  "build": {
    "beforeDevCommand": "npx vite --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://ereader-asset.localhost https://ereader-asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; font-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "minimumWebview2Version": "128.0.2739.42",
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false, "compression": "lzma", "installerHooks": "installer/hooks.nsh" }
    }
  }
}
