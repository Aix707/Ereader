{
  "name": "ereader",
  "version": "2.0.0",
  "private": true,
  "author": "Aix707",
  "description": "Lightweight local reader for Windows",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "vitest run",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:window": "node scripts/window-test.mjs",
    "benchmark": "node scripts/native.mjs --benchmark",
    "preview": "vite preview --host 127.0.0.1",
    "doctor": "node scripts/native.mjs --doctor",
    "package:win": "tauri build --bundles nsis && node scripts/package-report.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "release:win": "npm run package:win",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@zip.js/zip.js": "^2.8.26",
    "chardet": "^2.1.1",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/cli": "^0.1.22",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
